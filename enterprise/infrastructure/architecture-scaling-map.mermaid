%% Artifact Virtual - Complete Horizontal & Vertical Scaling Architecture
%% Monolithic Enterprise Infrastructure with Full Scaling Strategy

graph TB
    %% ============================================================================
    %% EXTERNAL LAYER - Load Balancing & Traffic Management
    %% ============================================================================
    
    subgraph EXTERNAL["🌐 EXTERNAL LAYER - Global Traffic Management"]
        DNS[DNS Service<br/>Route53 / CloudFlare<br/>Geo-routing & Failover]
        CDN[CDN Layer<br/>CloudFlare / Akamai<br/>Edge Caching<br/>🔄 Global Distribution]
        
        DNS --> CDN
    end
    
    %% ============================================================================
    %% LOAD BALANCER TIER - Horizontal Scaling Entry Point
    %% ============================================================================
    
    subgraph LB_TIER["⚖️ LOAD BALANCER TIER - Horizontal Scaling"]
        LB_PRIMARY[Primary Load Balancer<br/>HAProxy / NGINX<br/>Active]
        LB_SECONDARY[Secondary Load Balancer<br/>HAProxy / NGINX<br/>Standby]
        LB_TERTIARY[Tertiary Load Balancer<br/>HAProxy / NGINX<br/>Standby]
        
        LB_PRIMARY -.Failover.-> LB_SECONDARY
        LB_SECONDARY -.Failover.-> LB_TERTIARY
        
        HEALTH_LB[Health Check Service<br/>Keepalived / Consul]
        HEALTH_LB -.Monitor.-> LB_PRIMARY
        HEALTH_LB -.Monitor.-> LB_SECONDARY
    end
    
    CDN --> LB_PRIMARY
    CDN --> LB_SECONDARY
    
    %% ============================================================================
    %% WEB/API TIER - Horizontal Scaling Layer
    %% ============================================================================
    
    subgraph WEB_TIER["🖥️ WEB/API TIER - Horizontal Auto-Scaling"]
        subgraph WEB_CLUSTER_1["Web Cluster 1 - Local Pakistan"]
            WEB1_1[Web Server 1.1<br/>NGINX + App<br/>8GB RAM, 4 vCPU]
            WEB1_2[Web Server 1.2<br/>NGINX + App<br/>8GB RAM, 4 vCPU]
            WEB1_3[Web Server 1.3<br/>NGINX + App<br/>8GB RAM, 4 vCPU]
            WEB1_N[Web Server 1.N<br/>Auto-scaled<br/>📈 Scale to 20+ nodes]
        end
        
        subgraph WEB_CLUSTER_2["Web Cluster 2 - US/EU Virtual"]
            WEB2_1[Web Server 2.1<br/>NGINX + App<br/>16GB RAM, 8 vCPU]
            WEB2_2[Web Server 2.2<br/>NGINX + App<br/>16GB RAM, 8 vCPU]
            WEB2_N[Web Server 2.N<br/>Auto-scaled<br/>📈 Scale to 50+ nodes]
        end
        
        subgraph WEB_CLUSTER_3["Web Cluster 3 - Cloud Global"]
            WEB3_1[Web Server 3.1<br/>K8s Pod<br/>32GB RAM, 16 vCPU]
            WEB3_2[Web Server 3.2<br/>K8s Pod<br/>32GB RAM, 16 vCPU]
            WEB3_N[Web Server 3.N<br/>K8s HPA<br/>📈 Scale to 100+ pods]
        end
        
        WEB_AUTOSCALE[Auto-Scaling Engine<br/>CPU > 70% → Scale Up<br/>CPU < 30% → Scale Down<br/>Min: 3, Max: 100]
        WEB_AUTOSCALE -.Control.-> WEB1_N
        WEB_AUTOSCALE -.Control.-> WEB2_N
        WEB_AUTOSCALE -.Control.-> WEB3_N
    end
    
    LB_PRIMARY --> WEB1_1
    LB_PRIMARY --> WEB1_2
    LB_PRIMARY --> WEB2_1
    LB_PRIMARY --> WEB3_1
    
    %% ============================================================================
    %% APPLICATION TIER - Horizontal & Vertical Scaling
    %% ============================================================================
    
    subgraph APP_TIER["⚙️ APPLICATION TIER - Multi-Service Scaling"]
        subgraph AVRD_SERVICES["AVRD - R&D Services"]
            AVRD_OS1[Open Source Service 1<br/>16GB RAM, 8 vCPU]
            AVRD_OS2[Open Source Service 2<br/>16GB RAM, 8 vCPU]
            AVRD_PROP1[Proprietary Service 1<br/>32GB RAM, 16 vCPU]
            AVRD_PROP2[Proprietary Service 2<br/>32GB RAM, 16 vCPU]
            AVRD_SCALE[📈 Horizontal: 2-20 instances<br/>📊 Vertical: 8-64GB RAM]
        end
        
        subgraph AVML_SERVICES["AVML - Machine Layer Services"]
            AVML_DEV1[Development Service 1<br/>64GB RAM, 32 vCPU<br/>2x NVIDIA A100]
            AVML_DEV2[Development Service 2<br/>64GB RAM, 32 vCPU<br/>2x NVIDIA A100]
            AVML_DEPLOY1[Deployment Service 1<br/>32GB RAM, 16 vCPU]
            AVML_DEPLOY2[Deployment Service 2<br/>32GB RAM, 16 vCPU]
            AVML_SCALE[📈 Horizontal: 2-50 instances<br/>📊 Vertical: GPU scaling]
        end
        
        subgraph OPS_SERVICES["Operations Services"]
            OPS_LOCAL1[Local Ops Service 1<br/>16GB RAM, 8 vCPU]
            OPS_LOCAL2[Local Ops Service 2<br/>16GB RAM, 8 vCPU]
            OPS_VIRTUAL1[Virtual Ops Service 1<br/>32GB RAM, 16 vCPU]
            OPS_CLOUD1[Cloud Ops Service 1<br/>K8s Deployment]
            OPS_SCALE[📈 Horizontal: 2-30 instances<br/>📊 Vertical: Dynamic sizing]
        end
    end
    
    WEB1_1 --> AVRD_OS1
    WEB1_2 --> AVRD_PROP1
    WEB2_1 --> AVML_DEV1
    WEB2_2 --> AVML_DEPLOY1
    WEB3_1 --> OPS_CLOUD1
    
    %% ============================================================================
    %% MESSAGE QUEUE & ASYNC PROCESSING - Horizontal Scaling
    %% ============================================================================
    
    subgraph QUEUE_TIER["📨 MESSAGE QUEUE TIER - Event-Driven Scaling"]
        subgraph QUEUE_CLUSTER["Message Queue Cluster"]
            QUEUE1[RabbitMQ Node 1<br/>Primary<br/>16GB RAM, 8 vCPU]
            QUEUE2[RabbitMQ Node 2<br/>Mirror<br/>16GB RAM, 8 vCPU]
            QUEUE3[RabbitMQ Node 3<br/>Mirror<br/>16GB RAM, 8 vCPU]
            QUEUE_N[Queue Node N<br/>📈 Scale to 10 nodes]
        end
        
        subgraph WORKER_CLUSTER["Worker Pool - Horizontal Scaling"]
            WORKER1[Worker 1<br/>Job Processing<br/>8GB RAM, 4 vCPU]
            WORKER2[Worker 2<br/>Job Processing<br/>8GB RAM, 4 vCPU]
            WORKER3[Worker 3<br/>Job Processing<br/>8GB RAM, 4 vCPU]
            WORKER_N[Worker N<br/>📈 Scale to 50+ workers]
        end
        
        WORKER_SCALE[Worker Auto-Scaler<br/>Queue Depth > 1000 → +5 workers<br/>Queue Depth < 100 → -2 workers]
        WORKER_SCALE -.Control.-> WORKER_N
    end
    
    AVRD_OS1 --> QUEUE1
    AVML_DEV1 --> QUEUE1
    QUEUE1 --> WORKER1
    QUEUE2 --> WORKER2
    QUEUE3 --> WORKER3
    
    %% ============================================================================
    %% CACHE TIER - Horizontal Scaling with Sharding
    %% ============================================================================
    
    subgraph CACHE_TIER["💾 CACHE TIER - Distributed Caching"]
        subgraph CACHE_CLUSTER["Redis Cache Cluster - Horizontal Sharding"]
            CACHE_MASTER1[Redis Master 1<br/>Shard 1<br/>32GB RAM]
            CACHE_SLAVE1[Redis Replica 1<br/>Shard 1<br/>32GB RAM]
            CACHE_MASTER2[Redis Master 2<br/>Shard 2<br/>32GB RAM]
            CACHE_SLAVE2[Redis Replica 2<br/>Shard 2<br/>32GB RAM]
            CACHE_MASTER_N[Redis Master N<br/>Shard N<br/>📈 16 shards max]
        end
        
        CACHE_SENTINEL[Redis Sentinel<br/>Automatic Failover<br/>Master Election]
        CACHE_PROXY[Redis Proxy<br/>Twemproxy / Envoy<br/>Consistent Hashing]
        
        CACHE_SENTINEL -.Monitor.-> CACHE_MASTER1
        CACHE_SENTINEL -.Monitor.-> CACHE_MASTER2
        CACHE_PROXY --> CACHE_MASTER1
        CACHE_PROXY --> CACHE_MASTER2
        
        CACHE_SCALE[📈 Horizontal: 2-16 shards<br/>📊 Vertical: 8-128GB per node]
    end
    
    WEB1_1 --> CACHE_PROXY
    WEB2_1 --> CACHE_PROXY
    AVRD_OS1 --> CACHE_PROXY
    
    %% ============================================================================
    %% DATABASE TIER - Vertical & Horizontal Scaling
    %% ============================================================================
    
    subgraph DB_TIER["🗄️ DATABASE TIER - Master-Replica + Sharding"]
        subgraph PRIMARY_DB["Primary Database Cluster"]
            DB_MASTER[PostgreSQL Master<br/>Primary Writes<br/>128GB RAM, 32 vCPU<br/>2TB NVMe SSD]
            DB_REPLICA1[PostgreSQL Replica 1<br/>Read Queries<br/>64GB RAM, 16 vCPU<br/>2TB NVMe SSD]
            DB_REPLICA2[PostgreSQL Replica 2<br/>Read Queries<br/>64GB RAM, 16 vCPU<br/>2TB NVMe SSD]
            DB_REPLICA_N[PostgreSQL Replica N<br/>📈 Scale to 10 replicas]
            
            DB_MASTER -.Streaming Replication.-> DB_REPLICA1
            DB_MASTER -.Streaming Replication.-> DB_REPLICA2
        end
        
        subgraph SHARD_DB["Sharded Database Cluster"]
            DB_SHARD1[DB Shard 1<br/>User Data 1-1M<br/>64GB RAM, 16 vCPU]
            DB_SHARD2[DB Shard 2<br/>User Data 1M-2M<br/>64GB RAM, 16 vCPU]
            DB_SHARD_N[DB Shard N<br/>📈 Horizontal sharding]
        end
        
        DB_PROXY[PgBouncer / ProxySQL<br/>Connection Pooling<br/>Query Routing]
        DB_PROXY --> DB_MASTER
        DB_PROXY --> DB_REPLICA1
        DB_PROXY --> DB_REPLICA2
        
        DB_FAILOVER[Patroni / Stolon<br/>Automatic Failover<br/>Leader Election]
        DB_FAILOVER -.Monitor.-> DB_MASTER
        
        DB_SCALE[📈 Horizontal: Read replicas 2-10<br/>📈 Horizontal: Shards 1-20<br/>📊 Vertical: 64-256GB RAM]
    end
    
    AVRD_OS1 --> DB_PROXY
    AVML_DEV1 --> DB_PROXY
    OPS_LOCAL1 --> DB_PROXY
    WORKER1 --> DB_PROXY
    
    %% ============================================================================
    %% STORAGE TIER - Horizontal & Vertical Scaling
    %% ============================================================================
    
    subgraph STORAGE_TIER["💿 STORAGE TIER - Distributed Storage"]
        subgraph OBJECT_STORAGE["Object Storage - Horizontal Scaling"]
            OBJ_STORE1[MinIO Node 1<br/>10TB Storage<br/>16GB RAM]
            OBJ_STORE2[MinIO Node 2<br/>10TB Storage<br/>16GB RAM]
            OBJ_STORE3[MinIO Node 3<br/>10TB Storage<br/>16GB RAM]
            OBJ_STORE_N[MinIO Node N<br/>📈 Scale to 100 nodes<br/>Erasure Coding]
        end
        
        subgraph BLOCK_STORAGE["Block Storage - Ceph Cluster"]
            CEPH_MON1[Ceph Monitor 1<br/>Cluster State]
            CEPH_OSD1[Ceph OSD 1<br/>20TB Storage]
            CEPH_OSD2[Ceph OSD 2<br/>20TB Storage]
            CEPH_OSD_N[Ceph OSD N<br/>📈 Scale to 100 OSDs]
        end
        
        STORAGE_SCALE[📈 Horizontal: Unlimited nodes<br/>📊 Vertical: Add drives<br/>Replication: 3x default]
    end
    
    AVML_DEV1 --> OBJ_STORE1
    AVML_DEPLOY1 --> CEPH_OSD1
    DB_MASTER --> CEPH_OSD1
    
    %% ============================================================================
    %% ML/AI INFRASTRUCTURE - GPU Scaling
    %% ============================================================================
    
    subgraph ML_TIER["🤖 ML/AI TIER - GPU Cluster Scaling"]
        subgraph GPU_CLUSTER["GPU Compute Cluster"]
            GPU_NODE1[GPU Node 1<br/>8x NVIDIA A100<br/>256GB RAM, 64 vCPU]
            GPU_NODE2[GPU Node 2<br/>8x NVIDIA H100<br/>512GB RAM, 128 vCPU]
            GPU_NODE3[GPU Node 3<br/>8x NVIDIA A100<br/>256GB RAM, 64 vCPU]
            GPU_NODE_N[GPU Node N<br/>📈 Scale to 50 nodes<br/>400+ GPUs total]
        end
        
        subgraph ML_PLATFORM["ML Platform Services"]
            KUBEFLOW[Kubeflow<br/>ML Pipeline Orchestration<br/>K8s Native]
            MLFLOW[MLflow<br/>Experiment Tracking<br/>Model Registry]
            JUPYTER[JupyterHub<br/>Interactive Notebooks<br/>Multi-user]
        end
        
        GPU_SCHEDULER[GPU Job Scheduler<br/>Slurm / K8s Device Plugin<br/>Resource Allocation]
        GPU_SCHEDULER --> GPU_NODE1
        GPU_SCHEDULER --> GPU_NODE2
        
        ML_SCALE[📈 Horizontal: GPU nodes 2-50<br/>📊 Vertical: 4-8 GPUs per node<br/>Multi-GPU training support]
    end
    
    AVML_DEV1 --> KUBEFLOW
    AVML_DEV2 --> GPU_SCHEDULER
    
    %% ============================================================================
    %% MONITORING & OBSERVABILITY - Horizontal Scaling
    %% ============================================================================
    
    subgraph MONITORING_TIER["📊 MONITORING TIER - Full Stack Observability"]
        subgraph METRICS["Metrics Collection - Horizontal Scaling"]
            PROMETHEUS1[Prometheus 1<br/>Metrics Scraping<br/>16GB RAM]
            PROMETHEUS2[Prometheus 2<br/>Metrics Scraping<br/>16GB RAM]
            PROMETHEUS_FED[Prometheus Federation<br/>Global View]
            PROMETHEUS1 --> PROMETHEUS_FED
            PROMETHEUS2 --> PROMETHEUS_FED
        end
        
        subgraph LOGS["Log Aggregation - Horizontal Scaling"]
            ES_MASTER1[Elasticsearch Master 1<br/>Cluster Coordination]
            ES_DATA1[Elasticsearch Data 1<br/>32GB RAM, 2TB SSD]
            ES_DATA2[Elasticsearch Data 2<br/>32GB RAM, 2TB SSD]
            ES_DATA_N[Elasticsearch Data N<br/>📈 Scale to 20 nodes]
            LOGSTASH1[Logstash Node 1<br/>Log Processing]
            LOGSTASH2[Logstash Node 2<br/>Log Processing]
        end
        
        subgraph VISUALIZATION["Dashboards & Alerting"]
            GRAFANA[Grafana<br/>Metrics Visualization<br/>High Availability]
            KIBANA[Kibana<br/>Log Analysis<br/>Search Interface]
            ALERTMANAGER[AlertManager<br/>Alert Routing<br/>Deduplication]
        end
        
        MONITOR_SCALE[📈 Horizontal: Unlimited scalability<br/>📊 Vertical: Data node sizing<br/>Retention: 30-90 days]
    end
    
    WEB1_1 -.Metrics.-> PROMETHEUS1
    AVRD_OS1 -.Logs.-> LOGSTASH1
    PROMETHEUS_FED --> GRAFANA
    ES_DATA1 --> KIBANA
    PROMETHEUS_FED --> ALERTMANAGER
    
    %% ============================================================================
    %% BACKUP & DR - Geographic Redundancy
    %% ============================================================================
    
    subgraph BACKUP_TIER["💾 BACKUP & DISASTER RECOVERY"]
        subgraph PRIMARY_BACKUP["Primary Backup Site - Islamabad"]
            BACKUP_PRIMARY[Backup Server 1<br/>100TB Storage<br/>Continuous Backup]
        end
        
        subgraph SECONDARY_BACKUP["Secondary Backup Site - Cloud"]
            BACKUP_CLOUD[Cloud Backup<br/>S3 / Azure Blob<br/>Geo-Redundant]
        end
        
        subgraph DR_SITE["Disaster Recovery Site"]
            DR_ACTIVE[DR Environment<br/>Warm Standby<br/>50% Capacity<br/>📈 Scale to 100% on failover]
        end
        
        BACKUP_ORCHESTRATOR[Backup Orchestrator<br/>Bacula / Restic<br/>RPO: 15 min, RTO: 4 hours]
        
        BACKUP_ORCHESTRATOR --> BACKUP_PRIMARY
        BACKUP_PRIMARY --> BACKUP_CLOUD
        BACKUP_ORCHESTRATOR -.Replicate.-> DR_SITE
    end
    
    DB_MASTER -.Backup.-> BACKUP_ORCHESTRATOR
    OBJ_STORE1 -.Backup.-> BACKUP_ORCHESTRATOR
    
    %% ============================================================================
    %% SECURITY & COMPLIANCE - Layered Security
    %% ============================================================================
    
    subgraph SECURITY_TIER["🔒 SECURITY & COMPLIANCE TIER"]
        subgraph PERIMETER["Perimeter Security"]
            WAF[Web Application Firewall<br/>ModSecurity / Cloudflare<br/>DDoS Protection]
            IPS[Intrusion Prevention<br/>Suricata / Snort<br/>Threat Detection]
        end
        
        subgraph IDENTITY["Identity & Access Management"]
            IAM[IAM Service<br/>Keycloak / Auth0<br/>SSO / MFA]
            SECRETS[Secrets Management<br/>Vault / AWS Secrets<br/>Encryption]
        end
        
        subgraph COMPLIANCE["Compliance & Audit"]
            AUDIT[Audit Logging<br/>Compliance Reports<br/>SIEM Integration]
            VULN_SCAN[Vulnerability Scanner<br/>OpenVAS / Qualys<br/>Automated Scanning]
        end
        
        SECURITY_SCALE[📈 Horizontal: Security services<br/>🔐 Zero Trust Architecture<br/>Compliance: SOC2, ISO 27001]
    end
    
    CDN --> WAF
    WAF --> IPS
    IPS --> LB_PRIMARY
    
    %% ============================================================================
    %% NETWORK & CONNECTIVITY - Multi-Region
    %% ============================================================================
    
    subgraph NETWORK_TIER["🌐 NETWORK TIER - Global Connectivity"]
        subgraph REGION_PK["Pakistan Region - Islamabad DC"]
            NET_PK_CORE[Core Switch<br/>100Gbps<br/>Redundant]
            NET_PK_EDGE[Edge Router<br/>Multi-ISP<br/>BGP Peering]
        end
        
        subgraph REGION_US["US Region - Virtual/Cloud"]
            NET_US_CORE[Core Network<br/>AWS VPC / Azure VNet<br/>Transit Gateway]
        end
        
        subgraph REGION_EU["EU Region - Virtual/Cloud"]
            NET_EU_CORE[Core Network<br/>GCP VPC<br/>Interconnect]
        end
        
        VPN_MESH[VPN Mesh Network<br/>WireGuard / IPSec<br/>Encrypted Tunnels]
        
        NET_PK_CORE --> VPN_MESH
        NET_US_CORE --> VPN_MESH
        NET_EU_CORE --> VPN_MESH
        
        NETWORK_SCALE[📈 Bandwidth: 1-100 Gbps<br/>🌍 Multi-region connectivity<br/>Latency: <50ms intra-region]
    end
    
    %% ============================================================================
    %% DEPLOYMENT & CI/CD - Automation
    %% ============================================================================
    
    subgraph CICD_TIER["🚀 CI/CD & DEPLOYMENT AUTOMATION"]
        subgraph CI_PIPELINE["Continuous Integration"]
            GITLAB[GitLab CI<br/>Source Control<br/>Pipeline Orchestration]
            JENKINS[Jenkins<br/>Build Automation<br/>Multi-branch]
        end
        
        subgraph CD_PIPELINE["Continuous Deployment"]
            ARGOCD[ArgoCD<br/>GitOps<br/>K8s Deployment]
            SPINNAKER[Spinnaker<br/>Multi-cloud Deploy<br/>Canary/Blue-Green]
        end
        
        subgraph INFRA_CODE["Infrastructure as Code"]
            TERRAFORM[Terraform<br/>Multi-cloud IaC<br/>State Management]
            ANSIBLE[Ansible<br/>Configuration Mgmt<br/>Playbook Execution]
        end
        
        CICD_SCALE[📈 Parallel builds: 50+<br/>⚡ Deploy time: < 5 min<br/>🔄 Rollback: < 2 min]
    end
    
    GITLAB --> JENKINS
    JENKINS --> ARGOCD
    ARGOCD --> WEB_CLUSTER_3
    TERRAFORM --> NETWORK_TIER
    
    %% ============================================================================
    %% SCALING CONTROL & ORCHESTRATION
    %% ============================================================================
    
    subgraph ORCHESTRATION["🎛️ SCALING ORCHESTRATION & CONTROL"]
        SCALING_ENGINE[Central Scaling Engine<br/>Policy-Based Auto-Scaling<br/>Predictive Scaling AI]
        
        METRICS_AGGREGATOR[Metrics Aggregator<br/>Real-time Analytics<br/>Capacity Planning]
        
        SCALING_POLICIES[Scaling Policies<br/>CPU: 70% → Scale Up<br/>Memory: 80% → Scale Up<br/>Latency: >500ms → Scale Up<br/>Traffic: Predictive<br/>Cost Optimization]
        
        SCALING_ENGINE --> WEB_AUTOSCALE
        SCALING_ENGINE --> WORKER_SCALE
        SCALING_ENGINE --> DB_SCALE
        SCALING_ENGINE --> ML_SCALE
        
        METRICS_AGGREGATOR --> SCALING_ENGINE
        PROMETHEUS_FED -.Metrics.-> METRICS_AGGREGATOR
    end
    
    %% ============================================================================
    %% CAPACITY OVERVIEW
    %% ============================================================================
    
    subgraph CAPACITY["📊 CURRENT & MAXIMUM CAPACITY"]
        CURRENT[Current Capacity<br/>─────────────<br/>Web Servers: 10<br/>App Servers: 15<br/>DB Replicas: 3<br/>Cache Nodes: 4<br/>GPU Nodes: 3<br/>Workers: 20<br/>Total vCPUs: 500<br/>Total RAM: 2TB<br/>Total Storage: 100TB]
        
        MAXIMUM[Maximum Capacity<br/>─────────────<br/>Web Servers: 100+<br/>App Servers: 100+<br/>DB Replicas: 10+<br/>Cache Nodes: 16<br/>GPU Nodes: 50<br/>Workers: 200+<br/>Total vCPUs: 5000+<br/>Total RAM: 20TB+<br/>Total Storage: 1PB+]
        
        SCALING_PATH[Scaling Path<br/>─────────────<br/>Phase 1: 2x capacity (6 months)<br/>Phase 2: 5x capacity (12 months)<br/>Phase 3: 10x capacity (24 months)<br/>Cloud-native migration: 36 months]
    end
    
    %% Styling
    classDef external fill:#1a237e,stroke:#0d47a1,color:#fff,stroke-width:3px
    classDef lb fill:#0277bd,stroke:#01579b,color:#fff,stroke-width:2px
    classDef web fill:#0288d1,stroke:#0277bd,color:#fff,stroke-width:2px
    classDef app fill:#00838f,stroke:#006064,color:#fff,stroke-width:2px
    classDef queue fill:#00695c,stroke:#004d40,color:#fff,stroke-width:2px
    classDef cache fill:#558b2f,stroke:#33691e,color:#fff,stroke-width:2px
    classDef db fill:#f57c00,stroke:#e65100,color:#fff,stroke-width:2px
    classDef storage fill:#6a1b9a,stroke:#4a148c,color:#fff,stroke-width:2px
    classDef ml fill:#c62828,stroke:#b71c1c,color:#fff,stroke-width:2px
    classDef monitoring fill:#4527a0,stroke:#311b92,color:#fff,stroke-width:2px
    classDef security fill:#d32f2f,stroke:#c62828,color:#fff,stroke-width:2px
    classDef network fill:#00796b,stroke:#004d40,color:#fff,stroke-width:2px
    classDef cicd fill:#5d4037,stroke:#3e2723,color:#fff,stroke-width:2px
    classDef orchestration fill:#1565c0,stroke:#0d47a1,color:#fff,stroke-width:2px
    classDef capacity fill:#37474f,stroke:#263238,color:#fff,stroke-width:2px
    
    class EXTERNAL,DNS,CDN external
    class LB_TIER,LB_PRIMARY,LB_SECONDARY,LB_TERTIARY lb
    class WEB_TIER,WEB1_1,WEB1_2,WEB2_1,WEB3_1 web
    class APP_TIER,AVRD_SERVICES,AVML_SERVICES,OPS_SERVICES app
    class QUEUE_TIER,QUEUE1,QUEUE2,WORKER1,WORKER2 queue
    class CACHE_TIER,CACHE_MASTER1,CACHE_MASTER2,CACHE_PROXY cache
    class DB_TIER,DB_MASTER,DB_REPLICA1,DB_REPLICA2,DB_PROXY db
    class STORAGE_TIER,OBJ_STORE1,CEPH_OSD1 storage
    class ML_TIER,GPU_NODE1,GPU_NODE2,KUBEFLOW ml
    class MONITORING_TIER,PROMETHEUS1,ES_DATA1,GRAFANA monitoring
    class SECURITY_TIER,WAF,IPS,IAM security
    class NETWORK_TIER,NET_PK_CORE,VPN_MESH network
    class CICD_TIER,GITLAB,ARGOCD,TERRAFORM cicd
    class ORCHESTRATION,SCALING_ENGINE orchestration
    class CAPACITY,CURRENT,MAXIMUM,SCALING_PATH capacity
