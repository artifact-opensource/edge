FROM nginx:alpine

# Install required packages
RUN apk add --no-cache openssl

# Copy nginx configuration
COPY infrastructure/nginx/nginx.conf /etc/nginx/nginx.conf
COPY infrastructure/nginx/sites-available /etc/nginx/sites-available
COPY infrastructure/nginx/conf.d /etc/nginx/conf.d

# Create necessary directories
RUN mkdir -p /var/www/artifactvirtual && \
    mkdir -p /var/log/nginx && \
    mkdir -p /etc/nginx/sites-enabled

# Create symlink for enabled sites
RUN ln -s /etc/nginx/sites-available/artifactvirtual.conf /etc/nginx/sites-enabled/

# Health check
HEALTHCHECK --interval=30s --timeout=3s \
  CMD wget --quiet --tries=1 --spider http://localhost/health || exit 1

EXPOSE 80 443

CMD ["nginx", "-g", "daemon off;"]
