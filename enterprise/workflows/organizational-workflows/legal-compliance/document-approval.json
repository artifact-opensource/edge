{
  "enabled": false,
  "name": "Document Approval Workflow",
  "description": "Automated approval process for organizational documents",
  "department": "legal-compliance",
  "type": "organizational-workflow",
  "triggers": [
    "document_submission"
  ],
  "workflow_steps": [
    {
      "step": 1,
      "name": "initial_review",
      "enabled": false,
      "assignee_role": "legal_officer",
      "sla_hours": 24,
      "actions": ["approve", "reject", "request_changes"]
    },
    {
      "step": 2,
      "name": "compliance_check",
      "enabled": false,
      "assignee_role": "compliance_manager",
      "depends_on": "initial_review",
      "sla_hours": 48,
      "actions": ["approve", "reject", "escalate"]
    },
    {
      "step": 3,
      "name": "executive_approval",
      "enabled": false,
      "assignee_role": "executive_director",
      "depends_on": "compliance_check",
      "sla_hours": 72,
      "required_for": ["contracts", "policies"],
      "actions": ["approve", "reject"]
    },
    {
      "step": 4,
      "name": "final_publication",
      "enabled": false,
      "automated": true,
      "depends_on": "executive_approval",
      "actions": ["publish", "archive"]
    }
  ],
  "document_types": {
    "contracts": {
      "requires_all_steps": true
    },
    "policies": {
      "requires_all_steps": true
    },
    "procedures": {
      "skip_steps": ["executive_approval"]
    },
    "memos": {
      "skip_steps": ["compliance_check", "executive_approval"]
    }
  },
  "notifications": {
    "enabled": false,
    "notify_on": ["submission", "approval", "rejection", "sla_breach"],
    "channels": ["email", "in-app"]
  },
  "audit_trail": {
    "enabled": true,
    "retention_years": 7
  }
}
