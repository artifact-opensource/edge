{
  "enabled": false,
  "name": "AVRD CI/CD Pipeline",
  "description": "Continuous integration and deployment for AVRD projects",
  "department": "avrd",
  "type": "github-action",
  "triggers": [
    "push",
    "pull_request"
  ],
  "branches": [
    "main",
    "develop",
    "feature/*"
  ],
  "jobs": {
    "test": {
      "enabled": false,
      "runs_on": "ubuntu-latest",
      "steps": [
        "checkout",
        "setup-python",
        "install-dependencies",
        "run-tests",
        "upload-coverage"
      ]
    },
    "build": {
      "enabled": false,
      "runs_on": "ubuntu-latest",
      "needs": ["test"],
      "steps": [
        "checkout",
        "build-application",
        "create-artifact"
      ]
    },
    "deploy": {
      "enabled": false,
      "runs_on": "ubuntu-latest",
      "needs": ["build"],
      "environment": "production",
      "steps": [
        "download-artifact",
        "deploy-to-server"
      ]
    }
  },
  "notifications": {
    "enabled": false,
    "channels": ["slack", "email"]
  },
  "security_scanning": {
    "enabled": false,
    "tools": ["codeql", "dependabot"]
  }
}
