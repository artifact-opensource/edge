{
  "enabled": false,
  "name": "ML Model Training Pipeline",
  "description": "Automated ML model training and deployment for AVML",
  "department": "avml",
  "type": "github-action",
  "triggers": [
    "workflow_dispatch",
    "schedule"
  ],
  "schedule": "0 2 * * *",
  "jobs": {
    "data_validation": {
      "enabled": false,
      "runs_on": "ubuntu-latest",
      "steps": [
        "checkout",
        "validate-training-data",
        "check-data-quality"
      ]
    },
    "model_training": {
      "enabled": false,
      "runs_on": "gpu-runner",
      "needs": ["data_validation"],
      "timeout": 360,
      "steps": [
        "setup-ml-environment",
        "train-model",
        "evaluate-metrics"
      ]
    },
    "model_deployment": {
      "enabled": false,
      "runs_on": "ubuntu-latest",
      "needs": ["model_training"],
      "steps": [
        "register-model",
        "deploy-to-production",
        "run-smoke-tests"
      ]
    }
  },
  "gpu_resources": {
    "required": true,
    "type": "nvidia-a100",
    "count": 2
  },
  "notifications": {
    "enabled": false,
    "on_failure": true,
    "channels": ["slack"]
  }
}
