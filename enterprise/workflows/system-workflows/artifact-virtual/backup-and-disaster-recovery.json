{
  "enabled": false,
  "name": "Backup and Disaster Recovery",
  "description": "Automated backup, verification, and disaster recovery procedures for Artifact Virtual infrastructure",
  "department": "it-infrastructure",
  "type": "system-workflow",
  "schedule": "0 2 * * *",
  "timezone": "UTC",
  "tasks": [
    {
      "name": "full_system_backup",
      "enabled": false,
      "backup_targets": [
        {
          "name": "website_files",
          "path": "/var/www/artifactvirtual",
          "type": "filesystem",
          "compression": "gzip",
          "encryption": "aes-256",
          "incremental": false
        },
        {
          "name": "nginx_configuration",
          "path": "/etc/nginx/sites-available",
          "type": "filesystem",
          "compression": "gzip",
          "encryption": "aes-256"
        },
        {
          "name": "ssl_certificates",
          "path": "/etc/ssl",
          "type": "filesystem",
          "compression": "gzip",
          "encryption": "aes-256",
          "critical": true
        },
        {
          "name": "nginx_logs",
          "path": "/var/log/nginx/artifactvirtual-*.log",
          "type": "filesystem",
          "compression": "gzip",
          "retention_days": 90
        },
        {
          "name": "application_database",
          "type": "postgresql",
          "database": "artifactvirtual_db",
          "compression": "gzip",
          "encryption": "aes-256",
          "critical": true
        }
      ],
      "backup_destination": "/backups/daily",
      "remote_backup": {
        "enabled": false,
        "destination": "s3://artifact-virtual-backups",
        "region": "us-east-1",
        "storage_class": "STANDARD_IA"
      }
    },
    {
      "name": "backup_verification",
      "enabled": false,
      "depends_on": ["full_system_backup"],
      "verification_steps": [
        "verify_file_integrity",
        "verify_compression",
        "verify_encryption",
        "test_restore_sample",
        "verify_backup_size"
      ],
      "fail_on_verification_error": true
    },
    {
      "name": "incremental_backup",
      "enabled": false,
      "schedule": "0 */6 * * *",
      "backup_targets": [
        {
          "name": "website_files_incremental",
          "path": "/var/www/artifactvirtual",
          "type": "filesystem",
          "incremental": true,
          "base_backup": "daily"
        }
      ],
      "backup_destination": "/backups/incremental"
    },
    {
      "name": "backup_rotation",
      "enabled": false,
      "depends_on": ["backup_verification"],
      "retention_policy": {
        "daily_backups": 7,
        "weekly_backups": 4,
        "monthly_backups": 12,
        "yearly_backups": 3
      },
      "archive_old_backups": {
        "enabled": true,
        "destination": "s3://artifact-virtual-archive",
        "storage_class": "GLACIER"
      }
    },
    {
      "name": "disaster_recovery_test",
      "enabled": false,
      "schedule": "0 3 1 */3 *",
      "test_environment": "staging",
      "test_steps": [
        "provision_test_environment",
        "restore_latest_backup",
        "verify_website_functionality",
        "verify_api_endpoints",
        "verify_ssl_certificates",
        "test_performance",
        "cleanup_test_environment"
      ],
      "success_criteria": {
        "website_accessible": true,
        "api_functional": true,
        "data_integrity": 100,
        "performance_acceptable": true
      }
    },
    {
      "name": "backup_monitoring",
      "enabled": false,
      "monitors": [
        {
          "name": "backup_completion_time",
          "threshold_minutes": 60,
          "alert_on_exceed": true
        },
        {
          "name": "backup_size_variation",
          "expected_variance_percent": 20,
          "alert_on_exceed": true
        },
        {
          "name": "backup_success_rate",
          "minimum_success_rate": 99,
          "lookback_days": 7
        }
      ]
    },
    {
      "name": "shield256_backup",
      "enabled": false,
      "depends_on": ["full_system_backup"],
      "shield_encryption": true,
      "encryption_level": "military_grade",
      "passphrase_source": "secrets_manager",
      "backup_filename_pattern": "artifactvirtual-backup-{date}.zip",
      "backup_destination": "/backups/shield",
      "verification_required": true
    }
  ],
  "disaster_recovery_plan": {
    "enabled": true,
    "rto_minutes": 30,
    "rpo_minutes": 60,
    "recovery_priorities": [
      {
        "priority": 1,
        "component": "website",
        "max_downtime_minutes": 15
      },
      {
        "priority": 2,
        "component": "api",
        "max_downtime_minutes": 30
      },
      {
        "priority": 3,
        "component": "database",
        "max_downtime_minutes": 30
      }
    ],
    "failover_procedures": {
      "automatic_failover": false,
      "manual_approval_required": true,
      "failover_destination": "secondary_datacenter",
      "dns_update_method": "manual"
    }
  },
  "notifications": {
    "enabled": false,
    "on_backup_completion": true,
    "on_backup_failure": true,
    "on_verification_failure": true,
    "on_disaster_recovery_test": true,
    "channels": ["email", "slack"],
    "recipients": [
      "backup-team@artifactvirtual.com",
      "infrastructure@artifactvirtual.com"
    ]
  },
  "compliance": {
    "gdpr_compliant": true,
    "data_residency": "compliant",
    "encryption_at_rest": true,
    "encryption_in_transit": true,
    "audit_trail": true,
    "retention_policy_enforced": true
  }
}
