{
  "enabled": false,
  "name": "Infrastructure Monitoring and Alerting",
  "description": "Continuous monitoring of Artifact Virtual infrastructure, services, and performance",
  "department": "it-infrastructure",
  "type": "system-workflow",
  "schedule": "*/5 * * * *",
  "timezone": "UTC",
  "tasks": [
    {
      "name": "website_uptime_monitoring",
      "enabled": false,
      "endpoints": [
        {
          "url": "https://artifactvirtual.com",
          "expected_status": 200,
          "timeout_ms": 5000,
          "check_content": true,
          "content_pattern": "Artifact Virtual"
        },
        {
          "url": "https://artifactvirtual.com/health",
          "expected_status": 200,
          "expected_body": "OK",
          "timeout_ms": 3000
        },
        {
          "url": "https://artifactvirtual.com/api/status",
          "expected_status": 200,
          "check_json": true,
          "timeout_ms": 3000
        }
      ],
      "alert_on_failure": true,
      "consecutive_failures_threshold": 3
    },
    {
      "name": "performance_metrics",
      "enabled": false,
      "metrics": [
        {
          "name": "page_load_time",
          "url": "https://artifactvirtual.com",
          "threshold_ms": 3000,
          "warning_ms": 2000
        },
        {
          "name": "api_response_time",
          "endpoint": "/api/status",
          "threshold_ms": 1000,
          "warning_ms": 500
        },
        {
          "name": "time_to_first_byte",
          "threshold_ms": 500,
          "warning_ms": 300
        }
      ],
      "store_history": true,
      "history_retention_days": 90
    },
    {
      "name": "server_health_checks",
      "enabled": false,
      "checks": [
        {
          "name": "nginx_status",
          "command": "systemctl is-active nginx",
          "expected_output": "active",
          "critical": true
        },
        {
          "name": "disk_usage",
          "path": "/var/www",
          "threshold_percent": 85,
          "critical_percent": 95
        },
        {
          "name": "memory_usage",
          "threshold_percent": 90,
          "warning_percent": 80
        },
        {
          "name": "cpu_usage",
          "threshold_percent": 85,
          "warning_percent": 70,
          "duration_minutes": 5
        },
        {
          "name": "ssl_certificate_expiry",
          "domain": "artifactvirtual.com",
          "warning_days": 30,
          "critical_days": 7
        }
      ]
    },
    {
      "name": "nginx_log_analysis",
      "enabled": false,
      "log_files": [
        "/var/log/nginx/artifactvirtual-access.log",
        "/var/log/nginx/artifactvirtual-error.log"
      ],
      "analysis": {
        "error_rate_threshold": 0.5,
        "5xx_errors_threshold": 10,
        "4xx_errors_threshold": 50,
        "slow_request_threshold_ms": 5000
      },
      "alert_patterns": [
        "SSL handshake failed",
        "upstream timed out",
        "could not be resolved",
        "no live upstreams"
      ]
    },
    {
      "name": "security_monitoring",
      "enabled": false,
      "monitors": [
        {
          "name": "failed_login_attempts",
          "threshold": 5,
          "time_window_minutes": 10
        },
        {
          "name": "suspicious_requests",
          "patterns": [
            "SQL injection patterns",
            "XSS patterns",
            "Path traversal attempts",
            "Scanner fingerprints"
          ]
        },
        {
          "name": "rate_limit_violations",
          "threshold": 100,
          "time_window_minutes": 5
        },
        {
          "name": "geographic_anomalies",
          "enabled": false,
          "unexpected_countries": ["CN", "RU", "KP"],
          "alert_on_new_country": false
        }
      ]
    },
    {
      "name": "dependency_health_check",
      "enabled": false,
      "dependencies": [
        {
          "name": "api_backend",
          "url": "http://localhost:3000/health",
          "timeout_ms": 3000,
          "critical": true
        },
        {
          "name": "database",
          "type": "postgresql",
          "check_connectivity": true,
          "check_replication_lag": false,
          "critical": true
        }
      ]
    },
    {
      "name": "traffic_analysis",
      "enabled": false,
      "analysis": {
        "unique_visitors": true,
        "traffic_sources": true,
        "popular_pages": true,
        "bounce_rate": true,
        "geographic_distribution": true
      },
      "anomaly_detection": {
        "enabled": false,
        "traffic_spike_threshold": 300,
        "traffic_drop_threshold": 50,
        "unusual_user_agents": true
      }
    }
  ],
  "alerting": {
    "enabled": false,
    "alert_levels": {
      "critical": {
        "channels": ["pagerduty", "email", "sms"],
        "immediate": true
      },
      "warning": {
        "channels": ["slack", "email"],
        "immediate": false
      },
      "info": {
        "channels": ["slack"],
        "immediate": false
      }
    },
    "escalation": {
      "enabled": true,
      "escalate_after_minutes": 15,
      "escalation_contacts": [
        "cto@artifactvirtual.com",
        "infrastructure-lead@artifactvirtual.com"
      ]
    },
    "quiet_hours": {
      "enabled": false,
      "start": "22:00",
      "end": "08:00",
      "timezone": "Asia/Karachi",
      "suppress_non_critical": true
    }
  },
  "reporting": {
    "enabled": false,
    "reports": [
      {
        "name": "daily_uptime_report",
        "schedule": "0 9 * * *",
        "recipients": ["devops-team@artifactvirtual.com"]
      },
      {
        "name": "weekly_performance_report",
        "schedule": "0 9 * * 1",
        "recipients": ["engineering@artifactvirtual.com"]
      },
      {
        "name": "monthly_sla_report",
        "schedule": "0 9 1 * *",
        "recipients": ["management@artifactvirtual.com"]
      }
    ]
  },
  "sla_targets": {
    "uptime_percent": 99.9,
    "response_time_ms": 1000,
    "error_rate_percent": 0.1
  }
}
