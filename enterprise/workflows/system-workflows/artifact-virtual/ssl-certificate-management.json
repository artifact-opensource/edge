{
  "enabled": false,
  "name": "SSL Certificate Management",
  "description": "Automated SSL certificate renewal and monitoring for artifactvirtual.com domains",
  "department": "it-infrastructure",
  "type": "system-workflow",
  "schedule": "0 3 * * 0",
  "timezone": "UTC",
  "tasks": [
    {
      "name": "check_certificate_expiry",
      "enabled": false,
      "domains": [
        "artifactvirtual.com",
        "www.artifactvirtual.com",
        "api.artifactvirtual.com"
      ],
      "warning_days": 30,
      "critical_days": 14,
      "check_chain": true
    },
    {
      "name": "validate_certificate_health",
      "enabled": false,
      "checks": [
        "certificate_validity",
        "certificate_chain",
        "certificate_algorithm",
        "key_strength",
        "revocation_status"
      ],
      "ssl_labs_check": true,
      "minimum_grade": "A"
    },
    {
      "name": "renew_certificates",
      "enabled": false,
      "depends_on": ["check_certificate_expiry"],
      "method": "letsencrypt",
      "acme_challenge": "http-01",
      "webroot": "/var/www/certbot",
      "auto_renew_threshold_days": 30,
      "test_renewal": false
    },
    {
      "name": "update_nginx_certificates",
      "enabled": false,
      "depends_on": ["renew_certificates"],
      "certificate_path": "/etc/ssl/certs",
      "key_path": "/etc/ssl/private",
      "backup_old_certificates": true,
      "validate_config": true,
      "reload_nginx": true
    },
    {
      "name": "verify_new_certificates",
      "enabled": false,
      "depends_on": ["update_nginx_certificates"],
      "verification_urls": [
        "https://artifactvirtual.com",
        "https://www.artifactvirtual.com"
      ],
      "verify_ssl_handshake": true,
      "verify_certificate_match": true
    },
    {
      "name": "update_certificate_inventory",
      "enabled": false,
      "depends_on": ["verify_new_certificates"],
      "inventory_file": "/etc/ssl/certificate-inventory.json",
      "track_fields": [
        "domain",
        "issuer",
        "issue_date",
        "expiry_date",
        "serial_number",
        "fingerprint"
      ]
    }
  ],
  "notifications": {
    "enabled": false,
    "on_expiry_warning": true,
    "on_renewal_success": true,
    "on_renewal_failure": true,
    "channels": ["email", "slack"],
    "recipients": [
      "security-team@artifactvirtual.com",
      "devops-team@artifactvirtual.com"
    ]
  },
  "alerts": {
    "enabled": false,
    "critical_alerts": [
      "certificate_expired",
      "renewal_failed",
      "certificate_revoked",
      "ssl_grade_below_threshold"
    ],
    "warning_alerts": [
      "certificate_expiring_soon",
      "certificate_chain_incomplete",
      "weak_cipher_suites"
    ]
  },
  "compliance": {
    "pci_dss": true,
    "minimum_tls_version": "1.2",
    "required_cipher_suites": [
      "ECDHE-RSA-AES256-GCM-SHA384",
      "ECDHE-RSA-AES128-GCM-SHA256"
    ],
    "audit_log": true
  }
}
