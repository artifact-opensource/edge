{
  "enabled": false,
  "name": "CDN and Cache Management",
  "description": "Automated CDN configuration, cache invalidation, and optimization for Artifact Virtual",
  "department": "it-infrastructure",
  "type": "system-workflow",
  "triggers": {
    "manual": true,
    "webhook": true,
    "deployment": true
  },
  "tasks": [
    {
      "name": "nginx_cache_optimization",
      "enabled": false,
      "cache_zones": [
        {
          "name": "static_cache",
          "path": "/var/cache/nginx/static",
          "size_mb": 500,
          "inactive_time": "7d",
          "cache_types": ["image/jpeg", "image/png", "text/css", "application/javascript"]
        },
        {
          "name": "api_cache",
          "path": "/var/cache/nginx/api",
          "size_mb": 100,
          "inactive_time": "1h",
          "cache_types": ["application/json"]
        }
      ],
      "cache_purge_patterns": [
        "*.css",
        "*.js",
        "/api/*"
      ]
    },
    {
      "name": "cache_invalidation",
      "enabled": false,
      "triggers": [
        "deployment",
        "content_update",
        "configuration_change"
      ],
      "invalidation_strategy": "smart",
      "paths_to_invalidate": [
        "/",
        "/index.html",
        "/assets/*",
        "/api/*"
      ],
      "verify_invalidation": true
    },
    {
      "name": "cache_warming",
      "enabled": false,
      "depends_on": ["cache_invalidation"],
      "critical_urls": [
        "https://artifactvirtual.com/",
        "https://artifactvirtual.com/about",
        "https://artifactvirtual.com/products",
        "https://artifactvirtual.com/api/status"
      ],
      "warm_immediately": true,
      "verify_cached": true
    },
    {
      "name": "cache_analytics",
      "enabled": false,
      "metrics": [
        "cache_hit_ratio",
        "cache_miss_ratio",
        "cache_size_usage",
        "cache_eviction_rate",
        "cache_response_time"
      ],
      "reporting": {
        "daily_summary": true,
        "weekly_trends": true
      }
    },
    {
      "name": "browser_cache_headers",
      "enabled": false,
      "cache_policies": [
        {
          "pattern": "*.html",
          "cache_control": "public, max-age=3600",
          "expires": "+1h"
        },
        {
          "pattern": "*.{css,js}",
          "cache_control": "public, max-age=31536000, immutable",
          "expires": "+1y"
        },
        {
          "pattern": "*.{jpg,jpeg,png,gif,ico,svg}",
          "cache_control": "public, max-age=31536000, immutable",
          "expires": "+1y"
        },
        {
          "pattern": "/api/*",
          "cache_control": "no-cache, no-store, must-revalidate",
          "expires": "0"
        }
      ]
    },
    {
      "name": "compression_optimization",
      "enabled": false,
      "gzip_config": {
        "enabled": true,
        "level": 6,
        "types": [
          "text/html",
          "text/css",
          "application/javascript",
          "application/json",
          "image/svg+xml"
        ],
        "min_length": 1024
      },
      "brotli_config": {
        "enabled": false,
        "level": 4,
        "types": [
          "text/html",
          "text/css",
          "application/javascript",
          "application/json"
        ]
      }
    },
    {
      "name": "cache_health_monitoring",
      "enabled": false,
      "monitors": [
        {
          "name": "cache_hit_rate",
          "minimum_percent": 80,
          "alert_below_threshold": true
        },
        {
          "name": "cache_disk_usage",
          "maximum_percent": 90,
          "alert_above_threshold": true
        },
        {
          "name": "cache_eviction_rate",
          "maximum_per_minute": 100,
          "alert_above_threshold": true
        }
      ]
    }
  ],
  "cdn_configuration": {
    "enabled": false,
    "provider": "cloudflare",
    "domains": [
      "artifactvirtual.com",
      "www.artifactvirtual.com"
    ],
    "settings": {
      "always_use_https": true,
      "auto_minify": {
        "html": true,
        "css": true,
        "js": true
      },
      "brotli": true,
      "http2": true,
      "http3": true,
      "tls_1_3": true,
      "security_level": "medium",
      "cache_level": "aggressive"
    }
  },
  "performance_optimization": {
    "enabled": false,
    "image_optimization": {
      "enabled": false,
      "formats": ["webp", "avif"],
      "quality": 85,
      "lazy_loading": true
    },
    "asset_optimization": {
      "minify_css": true,
      "minify_js": true,
      "remove_comments": true,
      "optimize_fonts": true
    }
  },
  "notifications": {
    "enabled": false,
    "on_cache_invalidation": false,
    "on_optimization_complete": true,
    "on_performance_degradation": true,
    "channels": ["slack"],
    "recipients": ["devops-team@artifactvirtual.com"]
  }
}
