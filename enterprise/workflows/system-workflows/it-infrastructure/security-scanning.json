{
  "enabled": false,
  "name": "Security Vulnerability Scanning",
  "description": "Automated security scanning of infrastructure and applications",
  "department": "it-infrastructure",
  "type": "system-workflow",
  "schedule": "0 */6 * * *",
  "timezone": "UTC",
  "tasks": [
    {
      "name": "code_scanning",
      "enabled": false,
      "tool": "codeql",
      "targets": ["all-repositories"],
      "severity_threshold": "medium"
    },
    {
      "name": "dependency_scanning",
      "enabled": false,
      "tool": "dependabot",
      "targets": ["all-repositories"],
      "auto_update": false
    },
    {
      "name": "container_scanning",
      "enabled": false,
      "tool": "trivy",
      "targets": ["docker-images"],
      "fail_on": "critical"
    },
    {
      "name": "infrastructure_scanning",
      "enabled": false,
      "tool": "openvas",
      "targets": ["all-servers"],
      "scan_type": "full"
    },
    {
      "name": "web_application_scanning",
      "enabled": false,
      "tool": "owasp-zap",
      "targets": ["web-applications"],
      "scan_type": "active"
    }
  ],
  "reporting": {
    "enabled": false,
    "format": ["html", "json", "pdf"],
    "recipients": ["security-team@artifactvirtual.com"]
  },
  "remediation": {
    "auto_fix": false,
    "create_tickets": true,
    "priority_mapping": {
      "critical": "P0",
      "high": "P1",
      "medium": "P2",
      "low": "P3"
    }
  },
  "notifications": {
    "enabled": false,
    "on_vulnerabilities": true,
    "channels": ["slack", "email"]
  }
}
