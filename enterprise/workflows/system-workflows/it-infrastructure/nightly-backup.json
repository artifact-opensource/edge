{
  "enabled": false,
  "name": "Nightly Backup System",
  "description": "Automated nightly backup of all critical systems",
  "department": "it-infrastructure",
  "type": "system-workflow",
  "schedule": "0 2 * * *",
  "timezone": "Asia/Karachi",
  "tasks": [
    {
      "name": "database_backup",
      "enabled": false,
      "script": "scripts/backup/database-backup.sh",
      "timeout": 7200,
      "retry": 3,
      "targets": [
        "postgresql-master",
        "postgresql-replicas"
      ]
    },
    {
      "name": "application_backup",
      "enabled": false,
      "script": "scripts/backup/app-backup.sh",
      "timeout": 3600,
      "retry": 2,
      "targets": [
        "web-servers",
        "app-servers"
      ]
    },
    {
      "name": "configuration_backup",
      "enabled": false,
      "script": "scripts/backup/config-backup.sh",
      "timeout": 600,
      "retry": 2,
      "targets": [
        "nginx",
        "docker",
        "kubernetes"
      ]
    },
    {
      "name": "offsite_replication",
      "enabled": false,
      "script": "scripts/backup/offsite-replicate.sh",
      "timeout": 10800,
      "retry": 3,
      "targets": [
        "aws-s3",
        "azure-blob"
      ]
    }
  ],
  "notifications": {
    "enabled": false,
    "on_success": false,
    "on_failure": true,
    "channels": ["email", "slack"]
  },
  "monitoring": {
    "enabled": false,
    "metrics": ["backup_size", "backup_duration", "success_rate"]
  },
  "retention": {
    "daily": 7,
    "weekly": 4,
    "monthly": 12
  }
}
