{
  "version": 2,
  "name": "stakeholder-portal-api",
  "buildCommand": "cd backend && npm install && npm run vercel-build",
  "installCommand": "cd backend && npm install",
  "builds": [
    {
      "src": "backend/src/index.ts",
      "use": "@vercel/node",
      "config": {
        "includeFiles": ["backend/prisma/**"]
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "backend/src/index.ts"
    }
  ],
  "env": {
    "NODE_ENV": "production",
    "DATABASE_URL": "@stakeholder_portal_database_url",
    "REDIS_URL": "@stakeholder_portal_redis_url",
    "JWT_SECRET": "@stakeholder_portal_jwt_secret",
    "ALLOWED_EMAILS": "@stakeholder_portal_allowed_emails",
    "CORS_ORIGIN": "@stakeholder_portal_cors_origin"
  },
  "functions": {
    "backend/src/index.ts": {
      "memory": 1024,
      "maxDuration": 30
    }
  }
}
