# Environment
NODE_ENV=development
PORT=3000

# Authentication
# DISABLE_AUTH=false  # Set to 'true' to bypass authentication (DEVELOPMENT ONLY - NEVER in production)

# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/stakeholder_portal

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=your-jwt-secret-minimum-32-characters-long-please-change-this

# Access Control - Email Whitelist
# Comma-separated list of allowed emails (dev@example.com is auto-allowed in development)
# CRITICAL: Set this in production to control who can access the portal
ALLOWED_EMAILS=dev@example.com,admin@artifactvirtual.com,stakeholder@example.com

# OAuth (Google)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# AWS S3
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_S3_BUCKET=stakeholder-documents
AWS_REGION=us-east-1

# Email (SendGrid or similar)
SENDGRID_API_KEY=your-sendgrid-api-key
EMAIL_FROM=noreply@artifactvirtual.com

# Sentry
SENTRY_DSN=your-sentry-dsn

# CORS
CORS_ORIGIN=http://localhost:5173

# Rate Limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_TIMEWINDOW=60000

# File Upload
MAX_FILE_SIZE=10485760
