# Production Environment Variables
# Copy to .env.production and configure for your production environment

# Environment
NODE_ENV=production
PORT=3000

# Database (Vercel Postgres or AWS RDS)
# Format: postgresql://user:password@host:5432/database?sslmode=require
DATABASE_URL=postgresql://user:password@your-db-host.postgres.database.azure.com:5432/stakeholder_portal?sslmode=require

# Redis (Upstash or AWS ElastiCache)
# Format: redis://default:password@host:6379
REDIS_URL=redis://default:your-redis-password@your-redis-host.upstash.io:6379

# JWT Secret (CRITICAL - Generate with: openssl rand -base64 32)
JWT_SECRET=REPLACE_WITH_SECURE_RANDOM_32_CHAR_STRING

# Access Control - Email Whitelist (CRITICAL)
# Comma-separated list of emails allowed to access the portal
# No spaces, case-insensitive
ALLOWED_EMAILS=stakeholder1@example.com,stakeholder2@example.com,admin@artifactvirtual.com

# OAuth (Google) - Production Credentials
GOOGLE_CLIENT_ID=your-production-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-production-google-client-secret
GOOGLE_REDIRECT_URI=https://your-domain.vercel.app/auth/google/callback

# AWS S3 - Document Storage
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_S3_BUCKET=stakeholder-documents-prod
AWS_REGION=us-east-1

# Email (SendGrid)
SENDGRID_API_KEY=SG.your-sendgrid-api-key
EMAIL_FROM=noreply@artifactvirtual.com

# Sentry (Error Tracking)
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# CORS (Your production domain)
CORS_ORIGIN=https://your-domain.vercel.app

# Rate Limiting (requests per minute by tier)
# EXECUTIVE: 300, STRATEGIC: 200, STANDARD: 100, LIMITED: 30
RATE_LIMIT_MAX=300
RATE_LIMIT_TIMEWINDOW=60000

# File Upload (10MB default)
MAX_FILE_SIZE=10485760

# Session
SESSION_SECRET=REPLACE_WITH_SECURE_RANDOM_32_CHAR_STRING
SESSION_MAX_AGE=86400000

# Features
ENABLE_2FA=true
ENABLE_OAUTH=true
ENABLE_FILE_UPLOAD=true
ENABLE_NOTIFICATIONS=true
ENABLE_ANALYTICS=true

# Logging
LOG_LEVEL=info
PRETTY_PRINT=false
