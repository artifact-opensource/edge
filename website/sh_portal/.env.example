# Artifact Virtual — Stakeholder Portal Environment
# Copy this to .env and fill in real values. NEVER commit .env

# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_TO_SECURE_PASSWORD
POSTGRES_DB=stakeholder_portal

# Auth
JWT_SECRET=CHANGE_ME_TO_RANDOM_32_CHAR_STRING

# CORS
CORS_ORIGIN=http://localhost:5173

# Allowed admin emails (comma-separated)
ALLOWED_EMAILS=admin@artifactvirtual.com
