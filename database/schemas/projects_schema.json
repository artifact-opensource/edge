{
  "version": "1.0.0",
  "name": "Projects Database Schema",
  "description": "Schema for projects database with repo links and documentation",
  "databases": {
    "projects": {
      "description": "Master projects database",
      "properties": {
        "id": {"type": "string", "required": true},
        "project_name": {"type": "string", "required": true},
        "category": {"type": "select", "options": ["Flagship Products", "AI/ML & Research", "Blockchain", "Enterprise", "Collaboration", "Developer Tools", "Infrastructure"]},
        "subcategory": {"type": "string"},
        "status": {"type": "select", "options": ["Active", "Planning", "Complete", "Blocked", "Concept", "On Hold", "Cancelled"]},
        "lifecycle_stage": {"type": "select", "options": ["Ideation", "Planning", "Development", "Testing", "Staging", "Production", "Maintenance", "Sunset"]},
        "priority": {"type": "select", "options": ["P0 Critical", "P1 High", "P2 Medium", "P3 Low"]},
        "business_priority": {"type": "select", "options": ["Strategic", "High Value", "Growth", "Maintenance", "Experimental"]},
        "urgency": {"type": "select", "options": ["Immediate", "High", "Medium", "Low"]},
        "health_score": {"type": "number", "min": 0, "max": 100},
        "risk_score": {"type": "number", "min": 0, "max": 100},
        "progress": {"type": "number", "min": 0, "max": 100},
        "completion_confidence": {"type": "select", "options": ["High", "Medium", "Low", "At Risk"]},
        "start_date": {"type": "date"},
        "target_launch": {"type": "date"},
        "actual_launch": {"type": "date"},
        "last_milestone": {"type": "date"},
        "next_milestone": {"type": "date"},
        "project_lead": {"type": "string"},
        "technical_lead": {"type": "string"},
        "product_owner": {"type": "string"},
        "team_members": {"type": "array"},
        "team_size": {"type": "number"},
        "stakeholders": {"type": "array"},
        "sponsors": {"type": "array"},
        "budget_allocated": {"type": "currency", "currency": "USD"},
        "budget_spent": {"type": "currency", "currency": "USD"},
        "budget_remaining": {"type": "currency", "currency": "USD"},
        "roi_expected": {"type": "number"},
        "roi_actual": {"type": "number"},
        "github_repository": {"type": "url"},
        "documentation_url": {"type": "url"},
        "demo_url": {"type": "url"},
        "production_url": {"type": "url"},
        "tech_stack": {"type": "array"},
        "frameworks": {"type": "array"},
        "languages": {"type": "array"},
        "infrastructure": {"type": "array"},
        "dependencies": {"type": "array"},
        "blockers": {"type": "text"},
        "risks": {"type": "array"},
        "risk_level": {"type": "select", "options": ["Low", "Medium", "High", "Critical"]},
        "risk_mitigation": {"type": "text"},
        "description": {"type": "text"},
        "objectives": {"type": "text"},
        "business_value": {"type": "text"},
        "success_metrics": {"type": "text"},
        "kpis": {"type": "array"},
        "target_audience": {"type": "array"},
        "market_segment": {"type": "string"},
        "competitive_advantage": {"type": "text"},
        "open_source": {"type": "boolean"},
        "license": {"type": "select", "options": ["MIT", "Apache-2.0", "GPL-3.0", "BSD", "Proprietary", "Dual License"]},
        "visibility": {"type": "select", "options": ["Public", "Private", "Internal", "Partners Only"]},
        "classification": {"type": "select", "options": ["Public", "Internal", "Confidential", "Proprietary"]},
        "stars": {"type": "number"},
        "forks": {"type": "number"},
        "contributors": {"type": "number"},
        "issues_open": {"type": "number"},
        "issues_closed": {"type": "number"},
        "prs_open": {"type": "number"},
        "prs_merged": {"type": "number"},
        "last_commit": {"type": "date"},
        "commit_frequency": {"type": "string"},
        "code_coverage": {"type": "number", "min": 0, "max": 100},
        "build_status": {"type": "select", "options": ["Passing", "Failing", "Unknown"]},
        "deployment_status": {"type": "select", "options": ["Not Deployed", "Staging", "Production", "Failed"]},
        "readme_path": {"type": "string"},
        "docs_path": {"type": "string"},
        "changelog_path": {"type": "string"},
        "tags": {"type": "array"},
        "strategic_tags": {"type": "array"},
        "technology_tags": {"type": "array"},
        "business_tags": {"type": "array"},
        "related_projects": {"type": "array"},
        "parent_project": {"type": "string"},
        "child_projects": {"type": "array"},
        "integration_points": {"type": "array"},
        "compliance_requirements": {"type": "array"},
        "regulatory_notes": {"type": "text"},
        "metadata": {"type": "object"},
        "created_at": {"type": "datetime"},
        "updated_at": {"type": "datetime"},
        "last_activity": {"type": "datetime"}
      },
      "indexes": ["project_name", "category", "status", "priority", "open_source", "lifecycle_stage", "business_priority", "classification", "health_score"]
    },
    "project_tasks": {
      "description": "Project tasks and milestones",
      "properties": {
        "id": {"type": "string", "required": true},
        "task_name": {"type": "string", "required": true},
        "project_id": {"type": "string", "required": true},
        "status": {"type": "select", "options": ["Todo", "In Progress", "Review", "Done", "Blocked"]},
        "priority": {"type": "select", "options": ["Critical", "High", "Medium", "Low"]},
        "assignee": {"type": "string"},
        "due_date": {"type": "date"},
        "completed_date": {"type": "date"},
        "description": {"type": "text"},
        "tags": {"type": "array"},
        "created_at": {"type": "datetime"},
        "updated_at": {"type": "datetime"}
      },
      "indexes": ["task_name", "project_id", "status", "assignee"]
    },
    "project_documentation": {
      "description": "Project documentation pulled from repos",
      "properties": {
        "id": {"type": "string", "required": true},
        "project_id": {"type": "string", "required": true},
        "doc_title": {"type": "string", "required": true},
        "doc_type": {"type": "select", "options": ["README", "API", "Guide", "Tutorial", "Reference", "Changelog"]},
        "file_path": {"type": "string"},
        "content": {"type": "text"},
        "last_synced": {"type": "datetime"},
        "repo_url": {"type": "url"},
        "commit_sha": {"type": "string"},
        "created_at": {"type": "datetime"},
        "updated_at": {"type": "datetime"}
      },
      "indexes": ["project_id", "doc_title", "doc_type"]
    }
  }
}
