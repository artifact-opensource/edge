{
  "version": "1.0.0",
  "name": "Internal Database Schema",
  "description": "Schema for all internal data and documentation (management)",
  "databases": {
    "management": {
      "description": "Internal management data and decisions",
      "properties": {
        "id": {"type": "string", "required": true},
        "title": {"type": "string", "required": true},
        "type": {"type": "select", "options": ["Decision", "Directive", "Policy", "Strategy", "Review", "Initiative", "OKR"]},
        "department": {"type": "string"},
        "division": {"type": "string"},
        "status": {"type": "select", "options": ["Draft", "Review", "Approved", "Active", "Archived", "Cancelled"]},
        "lifecycle_stage": {"type": "select", "options": ["Ideation", "Planning", "Execution", "Monitoring", "Complete"]},
        "priority": {"type": "select", "options": ["P0 Critical", "P1 High", "P2 Medium", "P3 Low"]},
        "urgency": {"type": "select", "options": ["Immediate", "This Week", "This Month", "This Quarter", "Future"]},
        "business_impact": {"type": "select", "options": ["Strategic", "High", "Medium", "Low"]},
        "owner": {"type": "string"},
        "stakeholders": {"type": "array"},
        "decision_makers": {"type": "array"},
        "affected_parties": {"type": "array"},
        "content": {"type": "text"},
        "rationale": {"type": "text"},
        "expected_outcomes": {"type": "text"},
        "file_path": {"type": "string"},
        "decision_date": {"type": "date"},
        "effective_date": {"type": "date"},
        "review_date": {"type": "date"},
        "expiry_date": {"type": "date"},
        "tags": {"type": "array"},
        "strategic_tags": {"type": "array"},
        "related_docs": {"type": "array"},
        "dependencies": {"type": "array"},
        "risks": {"type": "array"},
        "risk_level": {"type": "select", "options": ["Low", "Medium", "High", "Critical"]},
        "compliance_tags": {"type": "array"},
        "regulatory_requirements": {"type": "array"},
        "classification": {"type": "select", "options": ["Public", "Internal", "Confidential", "Restricted", "Top Secret"]},
        "approval_required": {"type": "boolean"},
        "approved_by": {"type": "array"},
        "metadata": {"type": "object"},
        "created_at": {"type": "datetime"},
        "updated_at": {"type": "datetime"}
      },
      "indexes": ["title", "type", "status", "department", "priority", "classification", "lifecycle_stage"]
    },
    "operations": {
      "description": "Operational data and workflows",
      "properties": {
        "id": {"type": "string", "required": true},
        "operation_name": {"type": "string", "required": true},
        "type": {"type": "select", "options": ["Process", "Workflow", "Procedure", "Checklist", "Automation", "Integration"]},
        "department": {"type": "string"},
        "division": {"type": "string"},
        "status": {"type": "select", "options": ["Active", "Inactive", "Under Review", "Deprecated", "In Development"]},
        "priority": {"type": "select", "options": ["P0 Critical", "P1 High", "P2 Medium", "P3 Low"]},
        "business_criticality": {"type": "select", "options": ["Mission Critical", "Business Critical", "Important", "Standard"]},
        "frequency": {"type": "select", "options": ["Real-time", "Continuous", "Daily", "Weekly", "Monthly", "Quarterly", "Annual", "Ad-hoc"]},
        "owner": {"type": "string"},
        "responsible_team": {"type": "string"},
        "stakeholders": {"type": "array"},
        "description": {"type": "text"},
        "purpose": {"type": "text"},
        "steps": {"type": "array"},
        "dependencies": {"type": "array"},
        "prerequisites": {"type": "array"},
        "file_path": {"type": "string"},
        "sla": {"type": "string"},
        "avg_duration": {"type": "number"},
        "success_rate": {"type": "number", "min": 0, "max": 100},
        "last_run": {"type": "datetime"},
        "next_run": {"type": "datetime"},
        "automation_status": {"type": "select", "options": ["Manual", "Semi-Automated", "Fully Automated"]},
        "integration_points": {"type": "array"},
        "related_systems": {"type": "array"},
        "compliance_requirements": {"type": "array"},
        "risk_level": {"type": "select", "options": ["Low", "Medium", "High", "Critical"]},
        "tags": {"type": "array"},
        "classification": {"type": "select", "options": ["Public", "Internal", "Confidential", "Restricted"]},
        "metadata": {"type": "object"},
        "created_at": {"type": "datetime"},
        "updated_at": {"type": "datetime"}
      },
      "indexes": ["operation_name", "type", "department", "status", "priority", "business_criticality"]
    },
    "internal_documents": {
      "description": "Internal documentation",
      "properties": {
        "id": {"type": "string", "required": true},
        "title": {"type": "string", "required": true},
        "type": {"type": "select", "options": ["Policy", "Procedure", "Guide", "Template", "Report", "Analysis", "Documentation", "Roadmap", "Specification", "Standard"]},
        "category": {"type": "string"},
        "subcategory": {"type": "string"},
        "classification": {"type": "select", "options": ["Public", "Internal", "Confidential", "Restricted", "Top Secret"]},
        "sensitivity_level": {"type": "select", "options": ["Low", "Medium", "High", "Critical"]},
        "status": {"type": "select", "options": ["Draft", "Review", "Approved", "Active", "Archived", "Published", "Deprecated"]},
        "lifecycle_stage": {"type": "select", "options": ["Creation", "Review", "Active Use", "Maintenance", "Archive"]},
        "priority": {"type": "select", "options": ["P0 Critical", "P1 High", "P2 Medium", "P3 Low"]},
        "content": {"type": "text"},
        "summary": {"type": "text"},
        "file_path": {"type": "string"},
        "author": {"type": "string"},
        "contributors": {"type": "array"},
        "reviewers": {"type": "array"},
        "approvers": {"type": "array"},
        "department": {"type": "string"},
        "division": {"type": "string"},
        "version": {"type": "string"},
        "change_log": {"type": "text"},
        "published_date": {"type": "date"},
        "effective_date": {"type": "date"},
        "review_date": {"type": "date"},
        "expiry_date": {"type": "date"},
        "last_modified_date": {"type": "date"},
        "tags": {"type": "array"},
        "functional_tags": {"type": "array"},
        "compliance_tags": {"type": "array"},
        "technology_tags": {"type": "array"},
        "related_documents": {"type": "array"},
        "related_policies": {"type": "array"},
        "related_projects": {"type": "array"},
        "dependencies": {"type": "array"},
        "supersedes": {"type": "array"},
        "superseded_by": {"type": "string"},
        "compliance_requirements": {"type": "array"},
        "regulatory_references": {"type": "array"},
        "access_restrictions": {"type": "array"},
        "retention_period": {"type": "string"},
        "disposal_method": {"type": "string"},
        "keywords": {"type": "array"},
        "metadata": {"type": "object"},
        "created_at": {"type": "datetime"},
        "updated_at": {"type": "datetime"}
      },
      "indexes": ["title", "type", "classification", "status", "department", "priority", "sensitivity_level", "lifecycle_stage"]
    }
  }
}
