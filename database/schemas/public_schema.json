{
  "version": "1.0.0",
  "name": "Public Database Schema",
  "description": "Schema for all public data and documentation (stakeholder, community)",
  "databases": {
    "stakeholders": {
      "description": "Master stakeholder database",
      "properties": {
        "id": {"type": "string", "required": true},
        "name": {"type": "string", "required": true},
        "category": {"type": "select", "options": ["Investor", "Partner", "Advisor", "Board Member", "Customer", "Other"]},
        "tier": {"type": "select", "options": ["Executive", "Strategic", "Standard", "Limited"]},
        "status": {"type": "select", "options": ["Active", "Inactive", "Prospect", "Former"]},
        "lifecycle_stage": {"type": "select", "options": ["Discovery", "Qualification", "Engagement", "Active Partnership", "Renewal", "At Risk", "Churned"]},
        "priority": {"type": "select", "options": ["P0 Critical", "P1 High", "P2 Medium", "P3 Low"]},
        "business_impact": {"type": "select", "options": ["Strategic", "High Value", "Growth", "Maintenance", "Experimental"]},
        "region": {"type": "select", "options": ["Pakistan", "US", "EU", "MENA", "Asia Pacific", "Other"]},
        "engagement_score": {"type": "number", "min": 0, "max": 100},
        "health_score": {"type": "number", "min": 0, "max": 100},
        "sentiment": {"type": "select", "options": ["Very Positive", "Positive", "Neutral", "Negative", "Very Negative"]},
        "total_value": {"type": "currency", "currency": "USD"},
        "lifetime_value": {"type": "currency", "currency": "USD"},
        "first_contact": {"type": "date"},
        "last_contact": {"type": "date"},
        "next_action": {"type": "date"},
        "review_date": {"type": "date"},
        "email": {"type": "email"},
        "phone": {"type": "phone"},
        "company": {"type": "string"},
        "industry": {"type": "string"},
        "company_size": {"type": "select", "options": ["1-10", "11-50", "51-200", "201-500", "501-1000", "1000+"]},
        "linkedin": {"type": "url"},
        "tags": {"type": "array"},
        "custom_tags": {"type": "array"},
        "strategic_tags": {"type": "array"},
        "notes": {"type": "text"},
        "risk_level": {"type": "select", "options": ["Low", "Medium", "High", "Critical"]},
        "compliance_status": {"type": "select", "options": ["Compliant", "Pending", "Non-Compliant", "Not Applicable"]},
        "data_classification": {"type": "select", "options": ["Public", "Internal", "Confidential", "Restricted"]},
        "relationship_owner": {"type": "string"},
        "related_stakeholders": {"type": "array"},
        "related_projects": {"type": "array"},
        "related_documents": {"type": "array"},
        "integration_status": {"type": "select", "options": ["Not Started", "In Progress", "Integrated", "Archived"]},
        "metadata": {"type": "object"},
        "created_at": {"type": "datetime"},
        "updated_at": {"type": "datetime"},
        "last_activity": {"type": "datetime"},
        "source": {"type": "string"}
      },
      "indexes": ["name", "category", "status", "tier", "priority", "lifecycle_stage", "business_impact", "region", "data_classification"]
    },
    "community": {
      "description": "Community engagement and members",
      "properties": {
        "id": {"type": "string", "required": true},
        "member_name": {"type": "string", "required": true},
        "username": {"type": "string", "required": true},
        "member_type": {"type": "select", "options": ["Core", "Contributor", "Member", "Observer"]},
        "status": {"type": "select", "options": ["Active", "Inactive", "Alumni"]},
        "lifecycle_stage": {"type": "select", "options": ["Prospect", "Onboarding", "Active", "Champion", "At Risk", "Departed"]},
        "priority": {"type": "select", "options": ["P0 Critical", "P1 High", "P2 Medium", "P3 Low"]},
        "engagement_level": {"type": "select", "options": ["Very High", "High", "Medium", "Low", "Minimal"]},
        "join_date": {"type": "date"},
        "contributions": {"type": "number"},
        "contribution_score": {"type": "number", "min": 0, "max": 100},
        "github_username": {"type": "string"},
        "email": {"type": "email"},
        "skills": {"type": "array"},
        "skill_level": {"type": "select", "options": ["Beginner", "Intermediate", "Advanced", "Expert"]},
        "interests": {"type": "array"},
        "projects": {"type": "array"},
        "focus_areas": {"type": "array"},
        "tags": {"type": "array"},
        "recognition_badges": {"type": "array"},
        "achievements": {"type": "array"},
        "role": {"type": "string"},
        "availability": {"type": "select", "options": ["Full Time", "Part Time", "Occasional", "Unavailable"]},
        "timezone": {"type": "string"},
        "preferred_contact": {"type": "select", "options": ["Email", "Slack", "Discord", "GitHub"]},
        "last_activity": {"type": "datetime"},
        "metadata": {"type": "object"},
        "created_at": {"type": "datetime"},
        "updated_at": {"type": "datetime"}
      },
      "indexes": ["member_name", "username", "status", "member_type", "lifecycle_stage", "engagement_level"]
    },
    "public_documents": {
      "description": "Public documentation and announcements",
      "properties": {
        "id": {"type": "string", "required": true},
        "title": {"type": "string", "required": true},
        "type": {"type": "select", "options": ["Announcement", "Report", "Roadmap", "Documentation", "Policy", "Guide", "Tutorial", "Reference"]},
        "category": {"type": "string"},
        "subcategory": {"type": "string"},
        "status": {"type": "select", "options": ["Draft", "Review", "Published", "Archived", "Deprecated"]},
        "priority": {"type": "select", "options": ["P0 Critical", "P1 High", "P2 Medium", "P3 Low"]},
        "visibility": {"type": "select", "options": ["Public", "Stakeholders Only", "Community Only"]},
        "classification": {"type": "select", "options": ["Public", "Internal Use", "Sensitive"]},
        "content": {"type": "text"},
        "summary": {"type": "text"},
        "keywords": {"type": "array"},
        "file_path": {"type": "string"},
        "published_date": {"type": "date"},
        "last_reviewed": {"type": "date"},
        "next_review": {"type": "date"},
        "expiry_date": {"type": "date"},
        "author": {"type": "string"},
        "contributors": {"type": "array"},
        "approvers": {"type": "array"},
        "tags": {"type": "array"},
        "topic_tags": {"type": "array"},
        "target_audience": {"type": "array"},
        "related_documents": {"type": "array"},
        "related_projects": {"type": "array"},
        "version": {"type": "string"},
        "language": {"type": "string"},
        "read_time": {"type": "number"},
        "view_count": {"type": "number"},
        "engagement_score": {"type": "number", "min": 0, "max": 100},
        "seo_keywords": {"type": "array"},
        "external_url": {"type": "url"},
        "metadata": {"type": "object"},
        "created_at": {"type": "datetime"},
        "updated_at": {"type": "datetime"}
      },
      "indexes": ["title", "type", "status", "published_date", "priority", "classification", "visibility"]
    }
  }
}
